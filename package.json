{
  "name": "erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run parar && concurrently -n API,WEB -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/aplicacao.ts",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm run db:generate && npm run build --prefix frontend",
    "start": "npm run build && concurrently -n API,WEB -c blue,green \"npm run start:api\" \"npm run start:web\"",
    "start:api": "tsx src/aplicacao.ts",
    "start:web": "npm run start --prefix frontend",
    "parar": "npx kill-port 3333 3000",
    "db:migrate": "tsx scripts/executar-prisma.ts migrate dev",
    "db:seed": "tsx --import ./scripts/carregar-url-do-banco.ts prisma/seed.ts",
    "db:sync-permissoes": "tsx --import ./scripts/carregar-url-do-banco.ts scripts/sincronizar-permissoes.ts",
    "db:studio": "tsx scripts/executar-prisma.ts studio",
    "db:generate": "tsx scripts/executar-prisma.ts generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:frontend": "vitest run --config frontend/vitest.config.ts --root frontend"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1",
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "prisma": {
    "seed": "tsx --import ./scripts/carregar-url-do-banco.ts prisma/seed.ts"
  }
}
