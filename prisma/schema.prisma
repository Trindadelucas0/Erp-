// Schema do banco de dados do ERP.
// DATABASE_URL é montada em runtime a partir de DB_HOST, DB_PORT, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                          String                       @id @default(uuid())
  name                        String
  cnpj                        String                       @unique
  active                      Boolean                      @default(true)
  phone                       String?
  email                       String?
  cep                         String?
  logradouro                  String?
  numero                      String?
  complemento                 String?
  bairro                      String?
  cidade                      String?
  estado                      String?
  /// Override parcial de flags/calibração Entrada de Notas (null = só .env).
  recursosEntradaNotasJson    Json?
  users                       UserCompany[]
  pessoas                     Pessoa[]
  planosFinanceiros           PlanoFinanceiro[]
  cfops                       Cfop[]
  configuracaoZapsign         ConfiguracaoZapsign?
  documentosZapsign           ZapsignDocumento[]
  configuracaoFocusNfe        ConfiguracaoFocusNfe?
  focusNfeJobs                FocusNfeJob[]
  nfesRecebidas               NfeRecebida[]
  tratativasNfeRecebida       NfeRecebidaTratativa[]
  nfesRecebidasAnexos         NfeRecebidaAnexo[]
  despesasEntradaDocumento    DespesaEntradaDocumento[]
  produtos                    Produto[]
  pedidosCompra               PedidoCompra[]
  creditosFornecedor          CreditoFornecedor[]
  pendenciasFornecedor        PendenciaFornecedor[]
  movimentosCreditoFornecedor CreditoFornecedorMovimento[]
  unidadesMedida              UnidadeMedida[]
  marcas                      Marca[]
  estoqueSaldos               EstoqueSaldo[]
  estoqueMovimentos           EstoqueMovimento[]
  contagensEntrada            ContagemEntrada[]
  contasPagar                 ContaPagar[]
  contaPagarCodigoSeq         ContaPagarCodigoSeq?
  contasPagarBaixas           ContaPagarBaixa[]
  contasPagarAnexos           ContaPagarAnexo[]
  contasReceber               ContaReceber[]
  contaReceberCodigoSeq       ContaReceberCodigoSeq?
  contasReceberBaixas         ContaReceberBaixa[]
  contasReceberAnexos         ContaReceberAnexo[]
  jobs                        Job[]
  recorrenciasFinanceiras     RecorrenciaFinanceira[]
  createdAt                   DateTime                     @default(now())
}

// ─── Jobs — fila durável do worker ───────────────────────────────────────────

/// Fila de operações demoradas executadas fora do request HTTP.
/// Enfileirada pela API, consumida pelo worker (`src/compartilhado/jobs/`).
model Job {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// focus_sync | ia_conferencia
  tipo          String
  /// pendente | rodando | ok | erro
  status        String    @default("pendente")
  /// Impede dois jobs ativos do mesmo alvo (ex.: `pedido:<id>`). Null = sem dedupe.
  chaveDedupe   String?
  payloadJson   Json?
  /// Retorno do handler exposto no GET /jobs/:id (ex.: relatório da conferência).
  resultadoJson Json?
  progresso     Int       @default(0)
  mensagem      String?
  logResumo     String?
  /// Execuções já iniciadas; incrementado no claim.
  tentativas    Int       @default(0)
  maxTentativas Int       @default(1)
  /// Reexecuções após queda da API (não consomem `tentativas`).
  recuperacoes  Int       @default(0)
  /// Só pode ser reivindicado a partir deste instante (backoff / agendamento).
  agendadoPara  DateTime  @default(now())
  lockedAt      DateTime?
  lockedPor     String?
  iniciadoEm    DateTime?
  finalizadoEm  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, agendadoPara])
  @@index([companyId, tipo, status])
  @@index([companyId, createdAt])
}

// ─── ZapSign — Assinatura Digital ────────────────────────────────────────────

model ConfiguracaoZapsign {
  id            String   @id @default(uuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiToken      String
  sandbox       Boolean  @default(true)
  webhookSecret String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ZapsignDocumento {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenZapsign    String    @unique
  nomeDocumento   String
  status          String    @default("pendente")
  signatarioNome  String?
  signatarioEmail String?
  linkAssinatura  String?
  assinadoEm      DateTime?
  recusadoEm      DateTime?
  motivoRecusa    String?
  clientePessoaId String?
  clientePessoa   Pessoa?   @relation(fields: [clientePessoaId], references: [id])
  criadoEm        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Focus NFe — NFe Recebidas / Entrada de Notas ─────────────────────────────

model ConfiguracaoFocusNfe {
  id                       String   @id @default(uuid())
  companyId                String   @unique
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiToken                 String
  homologacao              Boolean  @default(true)
  ativo                    Boolean  @default(true)
  ultimaVersaoNfeRecebida  Int      @default(0)
  /// Versão incremental Focus GET /nfsens_recebidas (independente da NFe 55)
  ultimaVersaoNfseRecebida Int      @default(0)
  /// Versão incremental Focus GET /ctes_recebidas
  ultimaVersaoCteRecebida  Int      @default(0)
  /// Stub de regras fiscais de entrada (NCM, origem, CST/CFOP). ativo=false não bloqueia.
  regrasFiscaisJson        Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Legado: histórico de syncs anteriores ao worker. Novos jobs vão para `Job`.
model FocusNfeJob {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// sync | import_xml | manifestar
  tipo        String
  status      String    @default("pendente")
  progresso   Int       @default(0)
  mensagem    String?
  logResumo   String?
  payloadJson Json?
  iniciadoEm  DateTime?
  finalizadoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

model NfeRecebida {
  id                       String    @id @default(uuid())
  companyId                String
  company                  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chaveNfe                 String
  /// nfe55 | nfse | cte
  tipoDocumento            String    @default("nfe55")
  nomeEmitente             String?
  documentoEmitente        String?
  cnpjDestinatario         String?
  valorTotal               Decimal?  @db.Decimal(18, 2)
  dataEmissao              DateTime?
  situacao                 String?
  manifestacaoDestinatario String?
  nfeCompleta              Boolean   @default(false)
  tipoNfe                  String?
  versaoFocus              Int       @default(0)
  /// pendente | em_analise | stand_by | com_problema | problema_resolvido | aguardando_chegada | entrada_contagem | entrada_contagem_ok | entrada_contagem_divergente | pronta_para_consolidar | entrada_consolidada | cancelada
  statusEntrada            String    @default("pendente")
  /// NFe 55: revenda | uso_consumo | null (obrigatório clique explícito em análise)
  finalidadeEntrada        String?
  /// focus | xml
  origem                   String    @default("focus")
  /// automatica | humana | null
  origemLancamento         String?
  xmlConteudo              String?   @db.Text
  /// Path relativo do PDF DANFE/DANFSe em disco (uploads/nfe-recebidas/…)
  danfeCaminho             String?
  /// ok | indisponivel | rate_limit | null
  danfeStatus              String?
  danfeAtualizadoEm        DateTime?
  observacaoContato        String?
  criticasLiberadas        Boolean   @default(false)
  pedidoCompraId           String?
  /// cadastro | fiscal | negociacao | lancamento
  etapaAtual               String    @default("cadastro")
  fornecedorPessoaId       String?
  fornecedorPessoa         Pessoa?   @relation(fields: [fornecedorPessoaId], references: [id], onDelete: SetNull)
  /// Resumo das 3 etapas (avisos, bloqueios, positivo/negativo)
  analiseJson              Json?
  /// Prazo da NF (XML) se houver
  prazoPagamentoXml        String?
  /// Preenchimento humano quando NF sem prazo
  prazoPagamentoTexto      String?
  /// NFe 55: transp/modFrete (0=remetente … 1=destinatário … 9=sem frete)
  modFrete                 String?
  /// CTe: 1ª chave de NF-e referenciada no XML (infDoc/infNFe)
  chaveNfeReferenciada     String?
  /// CTe: CFOP de entrada sugerido (Cfop.cfopSugestaoEntradaId) ou escolhido manualmente na aba Frete/CT-e
  cfopEntradaId            String?
  cfopEntrada              Cfop?     @relation("NfeRecebidaCfopEntrada", fields: [cfopEntradaId], references: [id], onDelete: SetNull)
  /// solucao | desconhecimento | devolucao | null
  problemaDesfecho         String?
  problemaMarcadoEm        DateTime?
  problemaResolvidoEm      DateTime?
  /// bloqueio | null (devolução fica para fase futura)
  divergenciaDesfecho      String?
  divergenciaResolvidaEm   DateTime?
  /// Recorrência financeira que casou (fornecedor + valor) na Entrada
  recorrenciaFinanceiraId  String?
  recorrenciaFinanceira    RecorrenciaFinanceira? @relation(fields: [recorrenciaFinanceiraId], references: [id], onDelete: SetNull)
  /// Plano financeiro escolhido na análise (despesa/serviço ou mercadoria)
  planoFinanceiroId        String?
  planoFinanceiro          PlanoFinanceiro? @relation("NfeRecebidaPlanoFinanceiro", fields: [planoFinanceiroId], references: [id], onDelete: SetNull)
  /// Prévia financeira documental: [{ numeroDocumento, vencimento, valor }]
  parcelasFinanceiras      Json?
  itens                    NfeRecebidaItem[]
  tratativas               NfeRecebidaTratativa[]
  vinculosComoNfe          NfeCteVinculo[]          @relation("VinculoNfeMercadoria")
  vinculosComoCte          NfeCteVinculo[]          @relation("VinculoCte")
  despesasEntrada          DespesaEntradaDocumento[]
  contasPagar              ContaPagar[]
  contagensEntradaNotas    ContagemEntradaNota[]
  anexos                   NfeRecebidaAnexo[]
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([companyId, chaveNfe])
  @@index([companyId, statusEntrada])
  @@index([companyId, versaoFocus])
  @@index([companyId, fornecedorPessoaId])
  @@index([companyId, tipoDocumento])
  @@index([companyId, chaveNfeReferenciada])
  @@index([cfopEntradaId])
  @@index([recorrenciaFinanceiraId])
  @@index([planoFinanceiroId])
}

/// Anexo da NfeRecebida (hoje só a ressalva assinada da divergência de contagem).
model NfeRecebidaAnexo {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nfeRecebidaId  String
  nfeRecebida    NfeRecebida @relation(fields: [nfeRecebidaId], references: [id], onDelete: Cascade)
  /// ressalva_divergencia (única hoje; reservado p/ futuros tipos)
  tipoAnexo      String      @default("ressalva_divergencia")
  nomeArquivo    String
  mimeType       String
  caminhoArquivo String
  tamanhoBytes   Int
  usuarioId      String?
  usuario        User?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([companyId, nfeRecebidaId])
}

model NfeRecebidaTratativa {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nfeRecebidaId String
  nfeRecebida   NfeRecebida @relation(fields: [nfeRecebidaId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       User        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  texto         String      @db.Text
  createdAt     DateTime    @default(now())

  @@index([nfeRecebidaId, createdAt])
  @@index([companyId, nfeRecebidaId])
}

model NfeCteVinculo {
  id                   String      @id @default(uuid())
  companyId            String
  nfeRecebidaId        String
  nfeRecebida          NfeRecebida @relation("VinculoNfeMercadoria", fields: [nfeRecebidaId], references: [id], onDelete: Cascade)
  cteRecebidaId        String
  cteRecebida          NfeRecebida @relation("VinculoCte", fields: [cteRecebidaId], references: [id], onDelete: Cascade)
  chaveNfeReferenciada String?
  /// automatico | manual
  origemVinculo        String      @default("automatico")
  valorFrete           Decimal?    @db.Decimal(18, 2)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([cteRecebidaId])
  @@index([companyId, nfeRecebidaId])
  @@index([companyId, chaveNfeReferenciada])
}

model DespesaEntradaDocumento {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nfeRecebidaId     String
  nfeRecebida       NfeRecebida      @relation(fields: [nfeRecebidaId], references: [id], onDelete: Cascade)
  pessoaId          String?
  pessoa            Pessoa?          @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  planoFinanceiroId String?
  planoFinanceiro   PlanoFinanceiro? @relation(fields: [planoFinanceiroId], references: [id], onDelete: SetNull)
  valor             Decimal          @db.Decimal(18, 2)
  /// pendente | lancado
  status            String           @default("pendente")
  /// cte
  origem            String           @default("cte")
  /// Prévia financeiro (stub) — número do documento / título futuro
  numeroDocumento   String?
  vencimento        DateTime?
  /// Prévia com N duplicatas: [{ numeroDocumento, vencimento, valor }]
  parcelas          Json?
  contaPagar        ContaPagar?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([nfeRecebidaId, origem])
  @@index([companyId, status])
  @@index([pessoaId])
}

/// Sequência do código interno de Contas a Pagar por empresa (como SKU).
model ContaPagarCodigoSeq {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proximo   Int     @default(1)
}

model ContaPagar {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Código interno sequencial por empresa (exibição estilo 451.113)
  codigo            String
  /// duplicata | tributos
  tipo              String
  /// darf_simples | darf_normal | gps — só quando tipo=tributos
  tipoTributo       String?
  codigoReceita     String?
  numeroReferencia  String?
  pessoaId          String?
  pessoa            Pessoa?  @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  planoFinanceiroId String?
  planoFinanceiro   PlanoFinanceiro? @relation(fields: [planoFinanceiroId], references: [id], onDelete: SetNull)
  /// manual | nfe | cte
  origem            String   @default("manual")
  nfeRecebidaId     String?
  nfeRecebida       NfeRecebida? @relation(fields: [nfeRecebidaId], references: [id], onDelete: SetNull)
  despesaEntradaId  String?  @unique
  despesaEntrada    DespesaEntradaDocumento? @relation(fields: [despesaEntradaId], references: [id], onDelete: SetNull)
  numeroDocumento   String?
  dataEmissao       DateTime?
  /// aberto | parcial | pago | cancelado
  status            String   @default("aberto")
  valorTotal        Decimal  @db.Decimal(18, 2)
  valorDesconto     Decimal  @default(0) @db.Decimal(18, 2)
  valorJuros        Decimal  @default(0) @db.Decimal(18, 2)
  valorMulta        Decimal  @default(0) @db.Decimal(18, 2)
  valorImpostoRetido Decimal @default(0) @db.Decimal(18, 2)
  observacao        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parcelas ContaPagarParcela[]
  anexos   ContaPagarAnexo[]

  @@unique([companyId, codigo])
  @@index([companyId, status])
  @@index([companyId, tipo])
  @@index([pessoaId])
  @@index([nfeRecebidaId])
  @@index([planoFinanceiroId])
}

/// Anexo de documento do título (PDF/imagem), máx. 2 MB.
model ContaPagarAnexo {
  id             String     @id @default(uuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contaPagarId   String
  contaPagar     ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  nomeArquivo    String
  mimeType       String
  caminhoArquivo String
  tamanhoBytes   Int
  usuarioId      String?
  usuario        User?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([contaPagarId])
  @@index([companyId])
}

model ContaPagarParcela {
  id              String     @id @default(uuid())
  contaPagarId    String
  contaPagar      ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  numeroParcela   Int
  numeroDocumento String?
  vencimento      DateTime
  valor           Decimal    @db.Decimal(18, 2)
  valorPago       Decimal    @default(0) @db.Decimal(18, 2)
  /// aberta | parcial | paga | cancelada
  status          String     @default("aberta")
  pagoEm          DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  baixas          ContaPagarBaixa[]

  @@unique([contaPagarId, numeroParcela])
  @@index([vencimento])
  @@index([status])
}

/// Evento de pagamento (baixa total ou parcial) de uma parcela.
model ContaPagarBaixa {
  id                 String           @id @default(uuid())
  contaPagarParcelaId String
  parcela            ContaPagarParcela @relation(fields: [contaPagarParcelaId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pagoEm             DateTime
  valorPrincipal     Decimal          @db.Decimal(18, 2)
  valorJuros         Decimal          @default(0) @db.Decimal(18, 2)
  valorMulta         Decimal          @default(0) @db.Decimal(18, 2)
  valorDesconto      Decimal          @default(0) @db.Decimal(18, 2)
  usuarioId          String?
  usuario            User?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  observacao         String?
  createdAt          DateTime         @default(now())

  @@index([contaPagarParcelaId])
  @@index([companyId, pagoEm])
}

model ContaReceberCodigoSeq {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proximo   Int     @default(1)
}

model ContaReceber {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Código interno sequencial por empresa (exibição estilo 451.113)
  codigo            String
  /// duplicata | credito
  tipo              String
  pessoaId          String?
  pessoa            Pessoa?  @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  planoFinanceiroId String?
  planoFinanceiro   PlanoFinanceiro? @relation(fields: [planoFinanceiroId], references: [id], onDelete: SetNull)
  /// manual
  origem            String   @default("manual")
  numeroDocumento   String?
  dataEmissao       DateTime?
  /// aberto | parcial | pago | cancelado
  status            String   @default("aberto")
  valorTotal        Decimal  @db.Decimal(18, 2)
  valorDesconto     Decimal  @default(0) @db.Decimal(18, 2)
  valorJuros        Decimal  @default(0) @db.Decimal(18, 2)
  valorMulta        Decimal  @default(0) @db.Decimal(18, 2)
  valorComissao     Decimal  @default(0) @db.Decimal(18, 2)
  observacao        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parcelas ContaReceberParcela[]
  anexos   ContaReceberAnexo[]

  @@unique([companyId, codigo])
  @@index([companyId, status])
  @@index([companyId, tipo])
  @@index([pessoaId])
  @@index([planoFinanceiroId])
}

/// Anexo de documento do título (PDF/imagem), máx. 2 MB.
model ContaReceberAnexo {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contaReceberId String
  contaReceber   ContaReceber  @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)
  nomeArquivo    String
  mimeType       String
  caminhoArquivo String
  tamanhoBytes   Int
  usuarioId      String?
  usuario        User?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([contaReceberId])
  @@index([companyId])
}

model ContaReceberParcela {
  id              String        @id @default(uuid())
  contaReceberId  String
  contaReceber    ContaReceber  @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)
  numeroParcela   Int
  numeroDocumento String?
  vencimento      DateTime
  valor           Decimal       @db.Decimal(18, 2)
  valorPago       Decimal       @default(0) @db.Decimal(18, 2)
  /// aberta | parcial | paga | cancelada
  status          String        @default("aberta")
  pagoEm          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  baixas          ContaReceberBaixa[]

  @@unique([contaReceberId, numeroParcela])
  @@index([vencimento])
  @@index([status])
}

/// Evento de recebimento (baixa total ou parcial) de uma parcela.
model ContaReceberBaixa {
  id                   String              @id @default(uuid())
  contaReceberParcelaId String
  parcela              ContaReceberParcela @relation(fields: [contaReceberParcelaId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pagoEm               DateTime
  valorPrincipal       Decimal             @db.Decimal(18, 2)
  valorJuros           Decimal             @default(0) @db.Decimal(18, 2)
  valorMulta           Decimal             @default(0) @db.Decimal(18, 2)
  valorDesconto        Decimal             @default(0) @db.Decimal(18, 2)
  usuarioId            String?
  usuario              User?               @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  observacao           String?
  createdAt            DateTime            @default(now())

  @@index([contaReceberParcelaId])
  @@index([companyId, pagoEm])
}

model NfeRecebidaItem {
  id                 String      @id @default(uuid())
  nfeRecebidaId      String
  nfeRecebida        NfeRecebida @relation(fields: [nfeRecebidaId], references: [id], onDelete: Cascade)
  nItem              Int
  descricao          String?
  gtin               String?
  codigoProduto      String?
  ncm                String?
  cfop               String?
  cst                String?
  origem             String?
  /// Unidade comercial do item na NF (uCom do XML)
  unidade            String?
  quantidade         Decimal?    @db.Decimal(18, 4)
  valorUnitario      Decimal?    @db.Decimal(18, 4)
  valorTotal         Decimal?    @db.Decimal(18, 2)
  /// Peso líquido do item no XML (kg), se houver
  pesoKg             Decimal?    @db.Decimal(18, 4)
  produtoId          String?
  produto            Produto?    @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  /// barras | codigo_original | manual | desvinculado | null
  vinculoModo        String?
  criticaCadastro    Boolean     @default(false)
  criticaFiscal      Boolean     @default(false)
  criticaNegociacao  Boolean     @default(false)
  custoFreteRateado  Decimal?    @db.Decimal(18, 4)
  /// CFOP de entrada sugerido (Cfop.cfopSugestaoEntradaId) ou escolhido manualmente pelo usuário na aba Fiscal
  cfopEntradaId      String?
  cfopEntrada        Cfop?       @relation(fields: [cfopEntradaId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([nfeRecebidaId, nItem])
  @@index([nfeRecebidaId])
  @@index([produtoId])
  @@index([cfopEntradaId])
}

// ─── Cadastro Unificado de Pessoas ───────────────────────────────────────────

model Pessoa {
  id    String  @id @default(uuid())
  tipo  String // "PF" | "PJ"
  ativo Boolean @default(true)

  // PF
  cpf            String?
  rg             String?
  dataNascimento String?

  // PJ
  cnpj            String?
  nomeFantasia    String?
  cnae            String?
  dataFundacao    String?
  ie              String?
  im              String?
  suframa         String?
  simplesNacional Boolean @default(false)
  observacaoNF    String?

  // Compartilhado (nome completo PF / razão social PJ)
  nome String

  // Fiscal NF-e: 1=contribuinte ICMS, 2=contribuinte isento, 9=não contribuinte
  indicadorIe String  @default("9")
  observacoes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  papeis                      PessoaPapel[]
  contatos                    PessoaContato[]
  enderecos                   PessoaEndereco[]
  dadosBancarios              PessoaDadosBancario[]
  cnaes                       PessoaCnae[]
  documentosZapsign           ZapsignDocumento[]
  produtosFornecedor          ProdutoFornecedor[]
  pedidosCompraFornecedor     PedidoCompra[]        @relation("FornecedorPO")
  pedidosCompraTransportadora PedidoCompra[]        @relation("TransportadoraPO")
  creditosFornecedor          CreditoFornecedor[]
  pendenciasFornecedor        PendenciaFornecedor[]
  nfesRecebidasComoFornecedor NfeRecebida[]
  despesasEntradaDocumento    DespesaEntradaDocumento[]
  contasPagar                 ContaPagar[]
  contasReceber               ContaReceber[]
  estoqueMovimentosComoParceiro EstoqueMovimento[]
  recorrenciasFinanceiras     RecorrenciaFinanceira[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cpf, companyId]) // 
  @@unique([cnpj, companyId])
}

model PessoaPapel {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  papel     String // "cliente" | "fornecedor" | "transportadora"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  dadosCliente        DadosCliente?
  dadosFornecedor     DadosFornecedor?
  dadosTransportadora DadosTransportadora?

  @@unique([pessoaId, papel])
}

model DadosCliente {
  id      String      @id @default(uuid())
  papelId String      @unique
  papel   PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55       Boolean   @default(true)
  calculaComissao   Boolean   @default(false)
  vendedorId        String?
  statusAprovacao   String    @default("ativo")
  tipoCliente       String?
  limiteCredito     Decimal?  @db.Decimal(15, 2)
  condicaoPagamento String?
  motivoReprovacao  String?
  aprovadoPorId     String?
  aprovadoEm        DateTime?

  assinaturas ClienteAssinatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClienteAssinatura {
  id             String       @id @default(uuid())
  dadosClienteId String
  dadosCliente   DadosCliente @relation(fields: [dadosClienteId], references: [id], onDelete: Cascade)
  token          String       @unique
  status         String       @default("pendente")
  destinatario   String?
  enviadoEm      DateTime?
  visualizadoEm  DateTime?
  assinadoEm     DateTime?
  nomeAssinante  String?
  ipAssinante    String?
  expiraEm       DateTime?
  createdAt      DateTime     @default(now())
}

model DadosFornecedor {
  id      String      @id @default(uuid())
  papelId String      @unique
  papel   PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55                Boolean @default(true)
  tipoRevenda                Boolean @default(false)
  tipoConsumo                Boolean @default(false)
  tipoPrestadorServico       Boolean @default(false)
  permitirVinculoManual      Boolean @default(false)
  exigirItensEntrada         Boolean @default(false)
  prazoPagamento1            Int?
  prazoPagamento2            Int?
  prazoPagamento3            Int?
  prazoPagamento4            Int?
  prazoPagamento5            Int?
  prazoPagamento6            Int?
  modalidadeTransportePadrao String?
  /// valor | peso | quantidade | igual — rateio do CT-e nos itens da NF (null = não cadastrado)
  regraRateioFrete           String?
  observacoes                String?

  planosFinanceiros    FornecedorPlanoFinanceiro[]
  cfopsEntrada         FornecedorCfopEntrada[]
  paresPlanoCfopPadrao FornecedorParPlanoCfopPadrao[]
  vinculosComoA        FornecedorVinculo[]            @relation("VinculosA")
  vinculosComoB        FornecedorVinculo[]            @relation("VinculosB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FornecedorVinculo {
  id            String          @id @default(uuid())
  fornecedorAId String
  fornecedorBId String
  fornecedorA   DadosFornecedor @relation("VinculosA", fields: [fornecedorAId], references: [id], onDelete: Cascade)
  fornecedorB   DadosFornecedor @relation("VinculosB", fields: [fornecedorBId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([fornecedorAId, fornecedorBId])
}

model FornecedorParPlanoCfopPadrao {
  id                String          @id @default(uuid())
  dadosFornecedorId String
  dadosFornecedor   DadosFornecedor @relation(fields: [dadosFornecedorId], references: [id], onDelete: Cascade)
  planoFinanceiroId String
  planoFinanceiro   PlanoFinanceiro @relation(fields: [planoFinanceiroId], references: [id], onDelete: Cascade)
  cfopId            String
  cfop              Cfop            @relation(fields: [cfopId], references: [id], onDelete: Cascade)
  ordem             Int             @default(0)

  @@unique([dadosFornecedorId, planoFinanceiroId, cfopId])
}

model DadosTransportadora {
  id      String      @id @default(uuid())
  papelId String      @unique
  papel   PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55 Boolean @default(true)
  antt        String?
  tipoVeiculo String?
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PessoaContato {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo      String // "email" | "telefone"
  valor     String
  descricao String?
  whatsapp  Boolean  @default(false)
  principal Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PessoaEndereco {
  id          String   @id @default(uuid())
  pessoaId    String
  pessoa      Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo        String // "principal" | "entrega"
  apelido     String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  codigoIbge  String?
  createdAt   DateTime @default(now())
}

model PessoaDadosBancario {
  id                  String   @id @default(uuid())
  pessoaId            String
  pessoa              Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  apelido             String?
  banco               String?
  agencia             String?
  conta               String?
  tipoConta           String? // corrente | poupanca
  pix                 String?
  favorecido          String?
  documentoFavorecido String?
  principal           Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model PessoaCnae {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  codigo    String
  descricao String?
  principal Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([pessoaId, codigo])
}

model PlanoFinanceiro {
  id                      String                         @id @default(uuid())
  codigo                  String
  nome                    String
  tipo                    String                         @default("receita")
  classificacao           String?
  mostrarNaDre            Boolean                        @default(true)
  permiteLancamentoManual Boolean                        @default(false)
  exigeAnexoLancamento    Boolean                        @default(false)
  permiteUsoConsumo       Boolean                        @default(false)
  parentId                String?
  parent                  PlanoFinanceiro?               @relation("PlanoHierarquia", fields: [parentId], references: [id], onDelete: Restrict)
  children                PlanoFinanceiro[]              @relation("PlanoHierarquia")
  companyId               String
  company                 Company                        @relation(fields: [companyId], references: [id])
  ativo                   Boolean                        @default(true)
  fornecedores            FornecedorPlanoFinanceiro[]
  paresPlanoCfop          FornecedorParPlanoCfopPadrao[]
  despesasEntrada         DespesaEntradaDocumento[]
  contasPagar             ContaPagar[]
  contasReceber           ContaReceber[]
  cfopsComPlanoPadrao     Cfop[]                         @relation("CfopPlanoFinanceiroPadrao")
  nfesRecebidasPlano     NfeRecebida[]                  @relation("NfeRecebidaPlanoFinanceiro")
  createdAt               DateTime                       @default(now())

  @@unique([codigo, companyId])
  @@index([parentId])
  @@index([companyId, tipo])
}

model Cfop {
  id                    String                         @id @default(uuid())
  codigo                String
  nome                  String
  descricao             String                         @default("")
  tipoCfop              String                         @default("01")
  natureza              String                         @default("entrada")
  abrangencia           String?
  subtipoCfop           String?
  aproveitarCreditoIcms Boolean                        @default(false)
  tipo                  String                         @default("entrada")
  companyId             String
  company               Company                        @relation(fields: [companyId], references: [id])
  ativo                 Boolean                        @default(true)
  cfopSugestaoEntradaId String?
  cfopSugestaoEntrada   Cfop?                          @relation("CfopSugestaoEntrada", fields: [cfopSugestaoEntradaId], references: [id], onDelete: SetNull)
  cfopsComSugestao      Cfop[]                         @relation("CfopSugestaoEntrada")
  planoFinanceiroPadraoId String?
  planoFinanceiroPadrao   PlanoFinanceiro?             @relation("CfopPlanoFinanceiroPadrao", fields: [planoFinanceiroPadraoId], references: [id], onDelete: SetNull)
  fornecedores          FornecedorCfopEntrada[]
  paresPlanoCfop        FornecedorParPlanoCfopPadrao[]
  itensEntradaComCfop   NfeRecebidaItem[]
  documentosEntradaComCfop NfeRecebida[]               @relation("NfeRecebidaCfopEntrada")
  createdAt             DateTime                       @default(now())

  @@unique([codigo, companyId])
}

model FornecedorPlanoFinanceiro {
  dadosFornecedorId String
  planoFinanceiroId String
  dadosFornecedor   DadosFornecedor @relation(fields: [dadosFornecedorId], references: [id], onDelete: Cascade)
  planoFinanceiro   PlanoFinanceiro @relation(fields: [planoFinanceiroId], references: [id], onDelete: Cascade)

  @@id([dadosFornecedorId, planoFinanceiroId])
}

model FornecedorCfopEntrada {
  dadosFornecedorId String
  cfopId            String
  dadosFornecedor   DadosFornecedor @relation(fields: [dadosFornecedorId], references: [id], onDelete: Cascade)
  cfop              Cfop            @relation(fields: [cfopId], references: [id], onDelete: Cascade)

  @@id([dadosFornecedorId, cfopId])
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password          String
  cargo             String?          @default("")
  active            Boolean          @default(true)
  tokenVersion      Int              @default(0)
  tema              String           @default("escuro")
  roles             UserRole[]
  companies         UserCompany[]
  permissoesExtras  UserPermission[]
  paginasPermitidas UserPageAccess[]
  logsDeAuditoria   LogDeAuditoria[]
  tratativasNfe     NfeRecebidaTratativa[]
  estoqueMovimentos EstoqueMovimento[]
  contagensEntrada  ContagemEntrada[]
  contagensEntradaRevisoes ContagemEntradaRevisao[]
  contasPagarBaixas ContaPagarBaixa[]
  contasPagarAnexos ContaPagarAnexo[]
  contasReceberBaixas ContaReceberBaixa[]
  contasReceberAnexos ContaReceberAnexo[]
  nfesRecebidasAnexos NfeRecebidaAnexo[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model UserPageAccess {
  userId  String
  pageKey String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, pageKey])
}

model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id             String           @id @default(uuid())
  module         String
  action         String
  key            String           @unique
  roles          RolePermission[]
  usuariosExtras UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model LogDeAuditoria {
  id            String   @id @default(uuid())
  usuarioId     String
  acao          String
  entidade      String
  entidadeId    String
  valoresAntes  Json?
  valoresDepois Json?
  criadoEm      DateTime @default(now())
  usuario       User     @relation(fields: [usuarioId], references: [id])
}

model AtalhoTeclado {
  id        String   @id @default(uuid())
  acao      String   @unique
  tecla     String
  ativo     Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ─── Produtos ────────────────────────────────────────────────────────────────

model UnidadeMedida {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  sigla     String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sigla])
  @@index([companyId, ativo])
}

model Marca {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, nome])
  @@index([companyId, ativo])
}

model Produto {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  sku       String?
  ativo     Boolean @default(true)

  nomeVenda       String
  marca           String
  unidade         String  @default("UN")
  caracteristicas String?

  tipoEntrega             String? // pronta_entrega | sob_encomenda
  diasParaEntrega         Int?
  dataValidadePreco       DateTime?
  entregaNoAto            Boolean   @default(false)
  entregaARetirar         Boolean   @default(false)
  entregar                Boolean   @default(false)
  entregaPorEncomenda     Boolean   @default(false)
  flagDevolucao           Boolean   @default(false)
  controlaEstoque         Boolean   @default(true)
  flagComissao            Boolean   @default(false)
  permiteEstoqueNegativo  Boolean   @default(false)
  bloqueadoCompra         Boolean   @default(false)
  bloqueadoVenda          Boolean   @default(false)
  desativarAoZerarEstoque Boolean   @default(false)

  codigoBarras                String?
  pesoKg                      Decimal? @db.Decimal(15, 4)
  alturaCm                    Decimal? @db.Decimal(10, 2)
  larguraCm                   Decimal? @db.Decimal(10, 2)
  comprimentoCm               Decimal? @db.Decimal(10, 2)
  capacidadeEmpilhamento      Int?
  normaPalete                 String?
  multiploVenda               Decimal  @default(1) @db.Decimal(15, 4)
  permiteVendaFracionada      Boolean  @default(false)
  unidadeEntregaMultiploVenda String?

  nomeCompra              String?
  precoCusto              Decimal? @db.Decimal(15, 4)
  agruparSimilaresRuptura Boolean  @default(false)

  ncm          String?
  codigoOrigem String?

  fotos             ProdutoFoto[]
  fornecedores      ProdutoFornecedor[]
  embalagensMaster  ProdutoEmbalagemMaster[]
  enderecosEstoque  ProdutoEnderecoEstoque[]
  similares         ProdutoSimilar[]         @relation("ProdutoOrigem")
  similaresDe       ProdutoSimilar[]         @relation("ProdutoSimilar")
  itensPedidoCompra PedidoCompraItem[]
  pendencias        PendenciaFornecedor[]
  itensNfeRecebida     NfeRecebidaItem[]
  estoqueSaldo         EstoqueSaldo?
  estoqueMovimentos    EstoqueMovimento[]
  contagensEntradaItens ContagemEntradaItem[]
  recorrenciasFinanceiras RecorrenciaFinanceira[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, companyId])
  @@index([companyId, ativo])
  @@index([companyId, nomeVenda])
}

/// Regra de recorrência: fornecedor + valor esperado (+ periodicidade e vigência).
/// Quando a NFS-e/NFe documental chega com o mesmo emitente e valor (na vigência), a Entrada auto-consolida.
model RecorrenciaFinanceira {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fornecedorPessoaId  String
  fornecedorPessoa    Pessoa   @relation(fields: [fornecedorPessoaId], references: [id], onDelete: Restrict)
  produtoId           String?
  produto             Produto? @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  valor               Decimal  @db.Decimal(18, 2)
  /// mensal | anual
  periodicidade       String   @default("mensal")
  /// Dia do mês esperado (1–28)
  diaVencimento       Int      @default(1)
  /// Competência de início YYYY-MM
  competenciaInicio   String   @default("2020-01")
  /// Competência de fim YYYY-MM (null = sem fim)
  competenciaFim      String?
  ativo               Boolean  @default(true)
  nfesRecebidas       NfeRecebida[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId, fornecedorPessoaId, ativo])
  @@index([companyId, ativo])
  @@index([produtoId])
}

// ─── Contagem de entrada cega (logística) ─────────────────────────────────────

model ContagemEntrada {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// aberta | em_andamento | ok | divergente | cancelada
  status       String   @default("aberta")
  usuarioId    String?
  usuario      User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  iniciadoEm   DateTime?
  finalizadoEm DateTime?
  /// Admin baixou a contagem (trava logística até Voltar, se ainda não consolidou)
  baixadaEm    DateTime?
  observacao   String?
  /// Concorrência otimista — bip/patch/gravar/finalizar/cancelar incrementam
  versao       Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notas    ContagemEntradaNota[]
  itens    ContagemEntradaItem[]
  revisoes ContagemEntradaRevisao[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

/// Cópia cega da sessão em Gravar / Finalizar / Voltar admin / Cancelar (sem qtdEsperada)
model ContagemEntradaRevisao {
  id                String          @id @default(uuid())
  contagemEntradaId String
  contagemEntrada   ContagemEntrada @relation(fields: [contagemEntradaId], references: [id], onDelete: Cascade)
  usuarioId         String
  usuario           User            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  /// gravar | finalizar | voltar_admin | cancelar
  acao              String
  observacao        String?
  /// [{ produtoId, nomeExibicao, sku, qtdContada, statusItem }]
  itensJson         Json
  criadoEm          DateTime        @default(now())

  @@index([contagemEntradaId, criadoEm])
  @@index([usuarioId])
}

model ContagemEntradaNota {
  id                String         @id @default(uuid())
  contagemEntradaId String
  contagemEntrada   ContagemEntrada @relation(fields: [contagemEntradaId], references: [id], onDelete: Cascade)
  nfeRecebidaId     String
  nfeRecebida       NfeRecebida    @relation(fields: [nfeRecebidaId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())

  @@unique([contagemEntradaId, nfeRecebidaId])
  @@index([nfeRecebidaId])
}

model ContagemEntradaItem {
  id                String         @id @default(uuid())
  contagemEntradaId String
  contagemEntrada   ContagemEntrada @relation(fields: [contagemEntradaId], references: [id], onDelete: Cascade)
  produtoId         String
  produto           Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  /// Snapshot exibido ao conferente
  nomeExibicao      String
  codigoBarras      String?
  codigoOriginal    String?
  marca             String?
  unidade           String?
  qtdEmbalagemPadrao Decimal?      @db.Decimal(18, 4)
  /// Quantidade esperada em unidade de compra (qtd da NF) — NUNCA enviar ao cliente na API cega
  qtdEsperada       Decimal        @db.Decimal(18, 4)
  qtdContada        Decimal        @default(0) @db.Decimal(18, 4)
  /// pendente | ok | divergente
  statusItem        String         @default("pendente")
  updatedAt         DateTime       @updatedAt
  createdAt         DateTime       @default(now())

  @@unique([contagemEntradaId, produtoId])
  @@index([contagemEntradaId])
  @@index([produtoId])
}

// ─── Estoque — saldos + kardex (ledger append-only) ───────────────────────────

model EstoqueSaldo {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  produtoId    String   @unique
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  qtdFisica    Decimal  @default(0) @db.Decimal(18, 4)
  qtdReservada Decimal  @default(0) @db.Decimal(18, 4)
  qtdBloqueada Decimal  @default(0) @db.Decimal(18, 4)
  qtdFiscal    Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([companyId, produtoId])
  @@index([companyId])
}

model EstoqueMovimento {
  id                String   @id @default(uuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  produtoId         String
  produto           Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  /// fisico | fiscal | reserva | bloqueio
  dimensao          String
  /// inventario | entrada_nf | saida_nf | conferencia_ok | venda_reserva | ...
  tipoMovimento     String
  quantidade        Decimal  @db.Decimal(18, 4)
  saldoDepois       Decimal  @db.Decimal(18, 4)
  /// Snapshot do custo unitário na data do movimento (histórico imutável)
  precoCusto        Decimal? @db.Decimal(15, 4)
  /// nfe | conferencia | venda | inventario | manual | ...
  origem            String
  origemId          String?
  chaveIdempotencia String
  observacao        String?
  /// Parceiro da linha (fornecedor/cliente) — opcional
  pessoaId          String?
  pessoa            Pessoa?  @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  usuarioId         String?
  usuario           User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@unique([companyId, chaveIdempotencia])
  @@index([companyId, produtoId, createdAt])
  @@index([origem, origemId])
  @@index([pessoaId])
}

model ProdutoFornecedor {
  id                   String   @id @default(uuid())
  produtoId            String
  produto              Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorPessoaId   String
  fornecedor           Pessoa   @relation(fields: [fornecedorPessoaId], references: [id])
  codigoFornecedor     String?
  multiploEntrada      Decimal? @db.Decimal(15, 4)
  multiplicadorEntrada Decimal? @db.Decimal(15, 4)
  unidadeEntrada       String?
  ordem                Int      @default(0)
  createdAt            DateTime @default(now())

  @@unique([produtoId, fornecedorPessoaId])
}

model ProdutoEmbalagemMaster {
  id            String   @id @default(uuid())
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  quantidade    Decimal  @db.Decimal(15, 4)
  codigoBarras  String?
  alturaCm      Decimal? @db.Decimal(10, 2)
  larguraCm     Decimal? @db.Decimal(10, 2)
  comprimentoCm Decimal? @db.Decimal(10, 2)
  descricao     String?
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())
}

model ProdutoEnderecoEstoque {
  id        String  @id @default(uuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  apelido   String?
  endereco  String
  ordem     Int     @default(0)
}

model ProdutoSimilar {
  id               String  @id @default(uuid())
  produtoId        String
  produto          Produto @relation("ProdutoOrigem", fields: [produtoId], references: [id], onDelete: Cascade)
  similarProdutoId String
  similarProduto   Produto @relation("ProdutoSimilar", fields: [similarProdutoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, similarProdutoId])
}

model ProdutoFoto {
  id           String   @id @default(uuid())
  produtoId    String
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo         String // principal | miniatura
  arquivo      String
  tamanhoBytes Int
  larguraPx    Int?
  alturaPx     Int?
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([produtoId, tipo])
}

// ─── Pedido de Compra ────────────────────────────────────────────────────────

model PedidoCompra {
  id                     String                        @id @default(uuid())
  companyId              String
  company                Company                       @relation(fields: [companyId], references: [id])
  numero                 Int
  descricao              String?
  fornecedorPessoaId     String
  fornecedor             Pessoa                        @relation("FornecedorPO", fields: [fornecedorPessoaId], references: [id])
  transportadoraPessoaId String?
  transportadora         Pessoa?                       @relation("TransportadoraPO", fields: [transportadoraPessoaId], references: [id])
  modalidadeTransporte   String?
  condicaoPagamento      String?
  tipoCompra             String                        @default("revenda")
  dataFaturamento        DateTime?
  previsaoEntrega        DateTime?
  valorFrete             Decimal?                      @db.Decimal(15, 2)
  valorFreteSugerido     Decimal?                      @db.Decimal(15, 2)
  prazosPagamento        Json?
  rateioParcelas         String                        @default("igual")
  status                 String                        @default("rascunho")
  motivoCancelamento     String?
  observacoes            String?
  observacoesInternas    String?
  copiadoDeId            String?
  copiadoDe              PedidoCompra?                 @relation("CopiaPedido", fields: [copiadoDeId], references: [id])
  copias                 PedidoCompra[]                @relation("CopiaPedido")
  creditoFornecedorId    String?
  creditoFornecedor      CreditoFornecedor?            @relation(fields: [creditoFornecedorId], references: [id])
  creditoAplicado        Decimal?                      @db.Decimal(15, 2)
  creditoReserva         CreditoReservaPedido?
  movimentosCredito      CreditoFornecedorMovimento[]
  portalLiberadoEm       DateTime?
  portalBloqueadoEm      DateTime?
  acessosPortal          PedidoCompraAcessoPortal[]
  anexosFornecedor       PedidoCompraAnexoFornecedor[]

  itens PedidoCompraItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, numero])
  @@index([companyId, fornecedorPessoaId, status])
}

// ─── Portal do Fornecedor ────────────────────────────────────────────────────

model PedidoCompraAcessoPortal {
  id             String       @id @default(uuid())
  pedidoCompraId String
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  token          String       @unique
  criadoEm       DateTime     @default(now())
  expiraEm       DateTime
  revogadoEm     DateTime?

  @@index([pedidoCompraId])
}

model PedidoCompraAnexoFornecedor {
  id                       String       @id @default(uuid())
  pedidoCompraId           String
  pedidoCompra             PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  nomeArquivo              String
  mimeType                 String
  caminhoArquivo           String
  tamanhoBytes             Int
  enviadoEm                DateTime     @default(now())
  tipoAnexo                String       @default("documento_fornecedor")
  anexoOrigemId            String?
  statusConferencia        String       @default("pendente")
  motivoAjuste             String?
  decididoEm               DateTime?
  conferidoEm              DateTime?
  relatorioConferenciaJson Json?

  @@index([pedidoCompraId])
  @@index([anexoOrigemId])
}

model PedidoCompraItem {
  id                 String       @id @default(uuid())
  pedidoCompraId     String
  pedidoCompra       PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto      @relation(fields: [produtoId], references: [id])
  codigoOriginal     String?
  quantidade         Decimal      @db.Decimal(15, 4)
  unidade            String
  precoUnitario      Decimal      @db.Decimal(15, 4)
  percentualDesconto Decimal?     @db.Decimal(15, 4)
  valorDesconto      Decimal?     @db.Decimal(15, 2)
  outrasDespesas     Decimal?     @db.Decimal(15, 4)
  total              Decimal      @db.Decimal(15, 2)
  totalLiquido       Decimal?     @db.Decimal(15, 2)
  previsaoEntrega    DateTime?
  ordem              Int          @default(0)
}

model CreditoFornecedor {
  id                 String                       @id @default(uuid())
  companyId          String
  company            Company                      @relation(fields: [companyId], references: [id])
  fornecedorPessoaId String
  fornecedor         Pessoa                       @relation(fields: [fornecedorPessoaId], references: [id])
  valor              Decimal                      @db.Decimal(15, 2)
  saldo              Decimal                      @db.Decimal(15, 2)
  origem             String?
  vencimento         DateTime?
  pedidosCompra      PedidoCompra[]
  reservas           CreditoReservaPedido[]
  movimentos         CreditoFornecedorMovimento[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([companyId, fornecedorPessoaId])
}

model CreditoFornecedorMovimento {
  id                  String            @id @default(uuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  creditoFornecedorId String
  creditoFornecedor   CreditoFornecedor @relation(fields: [creditoFornecedorId], references: [id], onDelete: Cascade)
  tipo                String
  valor               Decimal           @db.Decimal(15, 2)
  saldoAnterior       Decimal           @db.Decimal(15, 2)
  saldoDepois         Decimal           @db.Decimal(15, 2)
  motivo              String?
  pedidoCompraId      String?
  pedidoCompra        PedidoCompra?     @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())

  @@index([creditoFornecedorId, createdAt])
  @@index([companyId, pedidoCompraId])
}

model CreditoReservaPedido {
  id                  String            @id @default(uuid())
  creditoFornecedorId String
  creditoFornecedor   CreditoFornecedor @relation(fields: [creditoFornecedorId], references: [id], onDelete: Cascade)
  pedidoCompraId      String            @unique
  pedidoCompra        PedidoCompra      @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  valor               Decimal           @db.Decimal(15, 2)
  status              String            @default("ativa")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([creditoFornecedorId, status])
}

model PendenciaFornecedor {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  fornecedorPessoaId String
  fornecedor         Pessoa   @relation(fields: [fornecedorPessoaId], references: [id])
  tipo               String
  descricao          String
  produtoId          String?
  produto            Produto? @relation(fields: [produtoId], references: [id])
  resolvido          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, fornecedorPessoaId, resolvido])
}
