// Schema do banco de dados do ERP.
// DATABASE_URL é montada em runtime a partir de DB_HOST, DB_PORT, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                          String                       @id @default(uuid())
  name                        String
  cnpj                        String                       @unique
  active                      Boolean                      @default(true)
  phone                       String?
  email                       String?
  cep                         String?
  logradouro                  String?
  numero                      String?
  complemento                 String?
  bairro                      String?
  cidade                      String?
  estado                      String?
  users                       UserCompany[]
  pessoas                     Pessoa[]
  planosFinanceiros           PlanoFinanceiro[]
  cfops                       Cfop[]
  configuracaoZapsign         ConfiguracaoZapsign?
  documentosZapsign           ZapsignDocumento[]
  produtos                    Produto[]
  pedidosCompra               PedidoCompra[]
  creditosFornecedor          CreditoFornecedor[]
  pendenciasFornecedor        PendenciaFornecedor[]
  movimentosCreditoFornecedor CreditoFornecedorMovimento[]
  unidadesMedida              UnidadeMedida[]
  marcas                      Marca[]
  createdAt                   DateTime                     @default(now())
}

// ─── ZapSign — Assinatura Digital ────────────────────────────────────────────

model ConfiguracaoZapsign {
  id            String   @id @default(uuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiToken      String
  sandbox       Boolean  @default(true)
  webhookSecret String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ZapsignDocumento {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tokenZapsign    String    @unique
  nomeDocumento   String
  status          String    @default("pendente")
  signatarioNome  String?
  signatarioEmail String?
  linkAssinatura  String?
  assinadoEm      DateTime?
  recusadoEm      DateTime?
  motivoRecusa    String?
  clientePessoaId String?
  clientePessoa   Pessoa?   @relation(fields: [clientePessoaId], references: [id])
  criadoEm        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── Cadastro Unificado de Pessoas ───────────────────────────────────────────

model Pessoa {
  id    String  @id @default(uuid())
  tipo  String // "PF" | "PJ"
  ativo Boolean @default(true)

  // PF
  cpf            String?
  rg             String?
  dataNascimento String?

  // PJ
  cnpj            String?
  nomeFantasia    String?
  cnae            String?
  dataFundacao    String?
  ie              String?
  im              String?
  suframa         String?
  simplesNacional Boolean @default(false)
  observacaoNF    String?

  // Compartilhado (nome completo PF / razão social PJ)
  nome String

  // Fiscal NF-e: 1=contribuinte ICMS, 2=contribuinte isento, 9=não contribuinte
  indicadorIe String  @default("9")
  observacoes String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  papeis                      PessoaPapel[]
  contatos                    PessoaContato[]
  enderecos                   PessoaEndereco[]
  dadosBancarios              PessoaDadosBancario[]
  cnaes                       PessoaCnae[]
  documentosZapsign           ZapsignDocumento[]
  produtosFornecedor          ProdutoFornecedor[]
  pedidosCompraFornecedor     PedidoCompra[]        @relation("FornecedorPO")
  pedidosCompraTransportadora PedidoCompra[]        @relation("TransportadoraPO")
  creditosFornecedor          CreditoFornecedor[]
  pendenciasFornecedor        PendenciaFornecedor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cpf, companyId]) // 
  @@unique([cnpj, companyId])
}

model PessoaPapel {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  papel     String // "cliente" | "fornecedor" | "transportadora"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  dadosCliente        DadosCliente?
  dadosFornecedor     DadosFornecedor?
  dadosTransportadora DadosTransportadora?

  @@unique([pessoaId, papel])
}

model DadosCliente {
  id      String      @id @default(uuid())
  papelId String      @unique
  papel   PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55       Boolean   @default(true)
  calculaComissao   Boolean   @default(false)
  vendedorId        String?
  statusAprovacao   String    @default("ativo")
  tipoCliente       String?
  limiteCredito     Decimal?  @db.Decimal(15, 2)
  condicaoPagamento String?
  motivoReprovacao  String?
  aprovadoPorId     String?
  aprovadoEm        DateTime?

  assinaturas ClienteAssinatura[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClienteAssinatura {
  id             String       @id @default(uuid())
  dadosClienteId String
  dadosCliente   DadosCliente @relation(fields: [dadosClienteId], references: [id], onDelete: Cascade)
  token          String       @unique
  status         String       @default("pendente")
  destinatario   String?
  enviadoEm      DateTime?
  visualizadoEm  DateTime?
  assinadoEm     DateTime?
  nomeAssinante  String?
  ipAssinante    String?
  expiraEm       DateTime?
  createdAt      DateTime     @default(now())
}

model DadosFornecedor {
  id      String      @id @default(uuid())
  papelId String      @unique
  papel   PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55                Boolean @default(true)
  tipoRevenda                Boolean @default(false)
  tipoConsumo                Boolean @default(false)
  tipoPrestadorServico       Boolean @default(false)
  permitirVinculoManual      Boolean @default(false)
  exigirItensEntrada         Boolean @default(false)
  prazoPagamento1            Int?
  prazoPagamento2            Int?
  prazoPagamento3            Int?
  prazoPagamento4            Int?
  prazoPagamento5            Int?
  prazoPagamento6            Int?
  modalidadeTransportePadrao String?
  observacoes                String?

  planosFinanceiros    FornecedorPlanoFinanceiro[]
  cfopsEntrada         FornecedorCfopEntrada[]
  paresPlanoCfopPadrao FornecedorParPlanoCfopPadrao[]
  vinculosComoA        FornecedorVinculo[]            @relation("VinculosA")
  vinculosComoB        FornecedorVinculo[]            @relation("VinculosB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FornecedorVinculo {
  id            String          @id @default(uuid())
  fornecedorAId String
  fornecedorBId String
  fornecedorA   DadosFornecedor @relation("VinculosA", fields: [fornecedorAId], references: [id], onDelete: Cascade)
  fornecedorB   DadosFornecedor @relation("VinculosB", fields: [fornecedorBId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@unique([fornecedorAId, fornecedorBId])
}

model FornecedorParPlanoCfopPadrao {
  id                String          @id @default(uuid())
  dadosFornecedorId String
  dadosFornecedor   DadosFornecedor @relation(fields: [dadosFornecedorId], references: [id], onDelete: Cascade)
  planoFinanceiroId String
  planoFinanceiro   PlanoFinanceiro @relation(fields: [planoFinanceiroId], references: [id], onDelete: Cascade)
  cfopId            String
  cfop              Cfop            @relation(fields: [cfopId], references: [id], onDelete: Cascade)
  ordem             Int             @default(0)

  @@unique([dadosFornecedorId, planoFinanceiroId, cfopId])
}

model DadosTransportadora {
  id      String      @id @default(uuid())
  papelId String      @unique
  papel   PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55 Boolean @default(true)
  antt        String?
  tipoVeiculo String?
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PessoaContato {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo      String // "email" | "telefone"
  valor     String
  descricao String?
  whatsapp  Boolean  @default(false)
  principal Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PessoaEndereco {
  id          String   @id @default(uuid())
  pessoaId    String
  pessoa      Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo        String // "principal" | "entrega"
  apelido     String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  codigoIbge  String?
  createdAt   DateTime @default(now())
}

model PessoaDadosBancario {
  id                  String   @id @default(uuid())
  pessoaId            String
  pessoa              Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  apelido             String?
  banco               String?
  agencia             String?
  conta               String?
  tipoConta           String? // corrente | poupanca
  pix                 String?
  favorecido          String?
  documentoFavorecido String?
  principal           Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model PessoaCnae {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  codigo    String
  descricao String?
  principal Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([pessoaId, codigo])
}

model PlanoFinanceiro {
  id                      String                         @id @default(uuid())
  codigo                  String
  nome                    String
  tipo                    String                         @default("receita")
  classificacao           String?
  mostrarNaDre            Boolean                        @default(true)
  permiteLancamentoManual Boolean                        @default(false)
  exigeAnexoLancamento    Boolean                        @default(false)
  permiteUsoConsumo       Boolean                        @default(false)
  parentId                String?
  parent                  PlanoFinanceiro?               @relation("PlanoHierarquia", fields: [parentId], references: [id], onDelete: Restrict)
  children                PlanoFinanceiro[]              @relation("PlanoHierarquia")
  companyId               String
  company                 Company                        @relation(fields: [companyId], references: [id])
  ativo                   Boolean                        @default(true)
  fornecedores            FornecedorPlanoFinanceiro[]
  paresPlanoCfop          FornecedorParPlanoCfopPadrao[]
  createdAt               DateTime                       @default(now())

  @@unique([codigo, companyId])
  @@index([parentId])
  @@index([companyId, tipo])
}

model Cfop {
  id                    String                         @id @default(uuid())
  codigo                String
  nome                  String
  descricao             String                         @default("")
  tipoCfop              String                         @default("01")
  natureza              String                         @default("entrada")
  abrangencia           String?
  subtipoCfop           String?
  aproveitarCreditoIcms Boolean                        @default(false)
  tipo                  String                         @default("entrada")
  companyId             String
  company               Company                        @relation(fields: [companyId], references: [id])
  ativo                 Boolean                        @default(true)
  cfopSugestaoEntradaId String?
  cfopSugestaoEntrada   Cfop?                          @relation("CfopSugestaoEntrada", fields: [cfopSugestaoEntradaId], references: [id], onDelete: SetNull)
  cfopsComSugestao      Cfop[]                         @relation("CfopSugestaoEntrada")
  fornecedores          FornecedorCfopEntrada[]
  paresPlanoCfop        FornecedorParPlanoCfopPadrao[]
  createdAt             DateTime                       @default(now())

  @@unique([codigo, companyId])
}

model FornecedorPlanoFinanceiro {
  dadosFornecedorId String
  planoFinanceiroId String
  dadosFornecedor   DadosFornecedor @relation(fields: [dadosFornecedorId], references: [id], onDelete: Cascade)
  planoFinanceiro   PlanoFinanceiro @relation(fields: [planoFinanceiroId], references: [id], onDelete: Cascade)

  @@id([dadosFornecedorId, planoFinanceiroId])
}

model FornecedorCfopEntrada {
  dadosFornecedorId String
  cfopId            String
  dadosFornecedor   DadosFornecedor @relation(fields: [dadosFornecedorId], references: [id], onDelete: Cascade)
  cfop              Cfop            @relation(fields: [cfopId], references: [id], onDelete: Cascade)

  @@id([dadosFornecedorId, cfopId])
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password          String
  cargo             String?          @default("")
  active            Boolean          @default(true)
  tokenVersion      Int              @default(0)
  tema              String           @default("escuro")
  roles             UserRole[]
  companies         UserCompany[]
  permissoesExtras  UserPermission[]
  paginasPermitidas UserPageAccess[]
  logsDeAuditoria   LogDeAuditoria[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model UserPageAccess {
  userId  String
  pageKey String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, pageKey])
}

model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id             String           @id @default(uuid())
  module         String
  action         String
  key            String           @unique
  roles          RolePermission[]
  usuariosExtras UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model LogDeAuditoria {
  id            String   @id @default(uuid())
  usuarioId     String
  acao          String
  entidade      String
  entidadeId    String
  valoresAntes  Json?
  valoresDepois Json?
  criadoEm      DateTime @default(now())
  usuario       User     @relation(fields: [usuarioId], references: [id])
}

model AtalhoTeclado {
  id        String   @id @default(uuid())
  acao      String   @unique
  tecla     String
  ativo     Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ─── Produtos ────────────────────────────────────────────────────────────────

model UnidadeMedida {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  sigla     String
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sigla])
  @@index([companyId, ativo])
}

model Marca {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, nome])
  @@index([companyId, ativo])
}

model Produto {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  sku       String?
  ativo     Boolean @default(true)

  nomeVenda       String
  marca           String
  unidade         String  @default("UN")
  caracteristicas String?

  tipoEntrega             String? // pronta_entrega | sob_encomenda
  diasParaEntrega         Int?
  dataValidadePreco       DateTime?
  entregaNoAto            Boolean   @default(false)
  entregaARetirar         Boolean   @default(false)
  entregar                Boolean   @default(false)
  entregaPorEncomenda     Boolean   @default(false)
  flagDevolucao           Boolean   @default(false)
  controlaEstoque         Boolean   @default(true)
  flagComissao            Boolean   @default(false)
  permiteEstoqueNegativo  Boolean   @default(false)
  bloqueadoCompra         Boolean   @default(false)
  bloqueadoVenda          Boolean   @default(false)
  desativarAoZerarEstoque Boolean   @default(false)

  codigoBarras                String?
  pesoKg                      Decimal? @db.Decimal(15, 4)
  alturaCm                    Decimal? @db.Decimal(10, 2)
  larguraCm                   Decimal? @db.Decimal(10, 2)
  comprimentoCm               Decimal? @db.Decimal(10, 2)
  capacidadeEmpilhamento      Int?
  normaPalete                 String?
  multiploVenda               Decimal  @default(1) @db.Decimal(15, 4)
  permiteVendaFracionada      Boolean  @default(false)
  unidadeEntregaMultiploVenda String?

  nomeCompra              String?
  precoCusto              Decimal? @db.Decimal(15, 4)
  agruparSimilaresRuptura Boolean  @default(false)

  ncm          String?
  codigoOrigem String?

  fotos             ProdutoFoto[]
  fornecedores      ProdutoFornecedor[]
  embalagensMaster  ProdutoEmbalagemMaster[]
  enderecosEstoque  ProdutoEnderecoEstoque[]
  similares         ProdutoSimilar[]         @relation("ProdutoOrigem")
  similaresDe       ProdutoSimilar[]         @relation("ProdutoSimilar")
  itensPedidoCompra PedidoCompraItem[]
  pendencias        PendenciaFornecedor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sku, companyId])
  @@index([companyId, ativo])
  @@index([companyId, nomeVenda])
}

model ProdutoFornecedor {
  id                   String   @id @default(uuid())
  produtoId            String
  produto              Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedorPessoaId   String
  fornecedor           Pessoa   @relation(fields: [fornecedorPessoaId], references: [id])
  codigoFornecedor     String?
  multiploEntrada      Decimal? @db.Decimal(15, 4)
  multiplicadorEntrada Decimal? @db.Decimal(15, 4)
  unidadeEntrada       String?
  ordem                Int      @default(0)
  createdAt            DateTime @default(now())

  @@unique([produtoId, fornecedorPessoaId])
}

model ProdutoEmbalagemMaster {
  id            String   @id @default(uuid())
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  quantidade    Decimal  @db.Decimal(15, 4)
  codigoBarras  String?
  alturaCm      Decimal? @db.Decimal(10, 2)
  larguraCm     Decimal? @db.Decimal(10, 2)
  comprimentoCm Decimal? @db.Decimal(10, 2)
  descricao     String?
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())
}

model ProdutoEnderecoEstoque {
  id        String  @id @default(uuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  apelido   String?
  endereco  String
  ordem     Int     @default(0)
}

model ProdutoSimilar {
  id               String  @id @default(uuid())
  produtoId        String
  produto          Produto @relation("ProdutoOrigem", fields: [produtoId], references: [id], onDelete: Cascade)
  similarProdutoId String
  similarProduto   Produto @relation("ProdutoSimilar", fields: [similarProdutoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, similarProdutoId])
}

model ProdutoFoto {
  id           String   @id @default(uuid())
  produtoId    String
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  tipo         String // principal | miniatura
  arquivo      String
  tamanhoBytes Int
  larguraPx    Int?
  alturaPx     Int?
  ordem        Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([produtoId, tipo])
}

// ─── Pedido de Compra ────────────────────────────────────────────────────────

model PedidoCompra {
  id                     String                        @id @default(uuid())
  companyId              String
  company                Company                       @relation(fields: [companyId], references: [id])
  numero                 Int
  descricao              String?
  fornecedorPessoaId     String
  fornecedor             Pessoa                        @relation("FornecedorPO", fields: [fornecedorPessoaId], references: [id])
  transportadoraPessoaId String?
  transportadora         Pessoa?                       @relation("TransportadoraPO", fields: [transportadoraPessoaId], references: [id])
  modalidadeTransporte   String?
  condicaoPagamento      String?
  tipoCompra             String                        @default("revenda")
  dataFaturamento        DateTime?
  previsaoEntrega        DateTime?
  valorFrete             Decimal?                      @db.Decimal(15, 2)
  valorFreteSugerido     Decimal?                      @db.Decimal(15, 2)
  prazosPagamento        Json?
  rateioParcelas         String                        @default("igual")
  status                 String                        @default("rascunho")
  motivoCancelamento     String?
  observacoes            String?
  observacoesInternas    String?
  copiadoDeId            String?
  copiadoDe              PedidoCompra?                 @relation("CopiaPedido", fields: [copiadoDeId], references: [id])
  copias                 PedidoCompra[]                @relation("CopiaPedido")
  creditoFornecedorId    String?
  creditoFornecedor      CreditoFornecedor?            @relation(fields: [creditoFornecedorId], references: [id])
  creditoAplicado        Decimal?                      @db.Decimal(15, 2)
  creditoReserva         CreditoReservaPedido?
  movimentosCredito      CreditoFornecedorMovimento[]
  portalLiberadoEm       DateTime?
  portalBloqueadoEm      DateTime?
  acessosPortal          PedidoCompraAcessoPortal[]
  anexosFornecedor       PedidoCompraAnexoFornecedor[]

  itens PedidoCompraItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, numero])
  @@index([companyId, fornecedorPessoaId, status])
}

// ─── Portal do Fornecedor ────────────────────────────────────────────────────

model PedidoCompraAcessoPortal {
  id             String       @id @default(uuid())
  pedidoCompraId String
  pedidoCompra   PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  token          String       @unique
  criadoEm       DateTime     @default(now())
  expiraEm       DateTime
  revogadoEm     DateTime?

  @@index([pedidoCompraId])
}

model PedidoCompraAnexoFornecedor {
  id                       String       @id @default(uuid())
  pedidoCompraId           String
  pedidoCompra             PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  nomeArquivo              String
  mimeType                 String
  caminhoArquivo           String
  tamanhoBytes             Int
  enviadoEm                DateTime     @default(now())
  tipoAnexo                String       @default("documento_fornecedor")
  anexoOrigemId            String?
  statusConferencia        String       @default("pendente")
  motivoAjuste             String?
  decididoEm               DateTime?
  conferidoEm              DateTime?
  relatorioConferenciaJson Json?

  @@index([pedidoCompraId])
  @@index([anexoOrigemId])
}

model PedidoCompraItem {
  id                 String       @id @default(uuid())
  pedidoCompraId     String
  pedidoCompra       PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  produtoId          String
  produto            Produto      @relation(fields: [produtoId], references: [id])
  codigoOriginal     String?
  quantidade         Decimal      @db.Decimal(15, 4)
  unidade            String
  precoUnitario      Decimal      @db.Decimal(15, 4)
  percentualDesconto Decimal?     @db.Decimal(15, 4)
  valorDesconto      Decimal?     @db.Decimal(15, 2)
  outrasDespesas     Decimal?     @db.Decimal(15, 4)
  total              Decimal      @db.Decimal(15, 2)
  totalLiquido       Decimal?     @db.Decimal(15, 2)
  previsaoEntrega    DateTime?
  ordem              Int          @default(0)
}

model CreditoFornecedor {
  id                 String                       @id @default(uuid())
  companyId          String
  company            Company                      @relation(fields: [companyId], references: [id])
  fornecedorPessoaId String
  fornecedor         Pessoa                       @relation(fields: [fornecedorPessoaId], references: [id])
  valor              Decimal                      @db.Decimal(15, 2)
  saldo              Decimal                      @db.Decimal(15, 2)
  origem             String?
  vencimento         DateTime?
  pedidosCompra      PedidoCompra[]
  reservas           CreditoReservaPedido[]
  movimentos         CreditoFornecedorMovimento[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([companyId, fornecedorPessoaId])
}

model CreditoFornecedorMovimento {
  id                  String            @id @default(uuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id])
  creditoFornecedorId String
  creditoFornecedor   CreditoFornecedor @relation(fields: [creditoFornecedorId], references: [id], onDelete: Cascade)
  tipo                String
  valor               Decimal           @db.Decimal(15, 2)
  saldoAnterior       Decimal           @db.Decimal(15, 2)
  saldoDepois         Decimal           @db.Decimal(15, 2)
  motivo              String?
  pedidoCompraId      String?
  pedidoCompra        PedidoCompra?     @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())

  @@index([creditoFornecedorId, createdAt])
  @@index([companyId, pedidoCompraId])
}

model CreditoReservaPedido {
  id                  String            @id @default(uuid())
  creditoFornecedorId String
  creditoFornecedor   CreditoFornecedor @relation(fields: [creditoFornecedorId], references: [id], onDelete: Cascade)
  pedidoCompraId      String            @unique
  pedidoCompra        PedidoCompra      @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  valor               Decimal           @db.Decimal(15, 2)
  status              String            @default("ativa")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([creditoFornecedorId, status])
}

model PendenciaFornecedor {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  fornecedorPessoaId String
  fornecedor         Pessoa   @relation(fields: [fornecedorPessoaId], references: [id])
  tipo               String
  descricao          String
  produtoId          String?
  produto            Produto? @relation(fields: [produtoId], references: [id])
  resolvido          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, fornecedorPessoaId, resolvido])
}
