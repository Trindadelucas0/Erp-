// Schema do banco de dados do ERP.
// DATABASE_URL é montada em runtime a partir de DB_HOST, DB_PORT, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String        @id @default(uuid())
  name        String
  cnpj        String        @unique
  active      Boolean       @default(true)
  phone       String?
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  users       UserCompany[]
  pessoas     Pessoa[]
  createdAt   DateTime      @default(now())
}

// ─── Cadastro Unificado de Pessoas ───────────────────────────────────────────

model Pessoa {
  id              String   @id @default(uuid())
  tipo            String   // "PF" | "PJ"
  ativo           Boolean  @default(true)

  // PF
  cpf             String?
  rg              String?
  dataNascimento  String?

  // PJ
  cnpj            String?
  nomeFantasia    String?
  cnae            String?
  dataFundacao    String?
  ie              String?
  im              String?
  suframa         String?
  simplesNacional Boolean  @default(false)
  observacaoNF    String?

  // Compartilhado (nome completo PF / razão social PJ)
  nome            String

  // Fiscal NF-e: 1=contribuinte ICMS, 2=contribuinte isento, 9=não contribuinte
  indicadorIe     String   @default("9")
  observacoes     String?

  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])

  papeis          PessoaPapel[]
  contatos        PessoaContato[]
  enderecos       PessoaEndereco[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cpf, companyId]) // fazendo tes
  @@unique([cnpj, companyId])
}

model PessoaPapel {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  papel     String   // "cliente" | "fornecedor" | "transportadora"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  dadosCliente        DadosCliente?
  dadosFornecedor     DadosFornecedor?
  dadosTransportadora DadosTransportadora?

  @@unique([pessoaId, papel])
}

model DadosCliente {
  id               String      @id @default(uuid())
  papelId          String      @unique
  papel            PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  aceitaNFe55      Boolean  @default(true)
  calculaComissao  Boolean  @default(false)
  vendedorId       String?
  statusAprovacao  String   @default("ativo")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DadosFornecedor {
  id                String      @id @default(uuid())
  papelId           String      @unique
  papel             PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  condicaoPagamento String?
  prazoEntrega      Int?
  observacoes       String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DadosTransportadora {
  id          String      @id @default(uuid())
  papelId     String      @unique
  papel       PessoaPapel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  antt        String?
  tipoVeiculo String?
  observacoes String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PessoaContato {
  id        String   @id @default(uuid())
  pessoaId  String
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo      String   // "email" | "telefone"
  valor     String
  descricao String?
  whatsapp  Boolean  @default(false)
  principal Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PessoaEndereco {
  id          String   @id @default(uuid())
  pessoaId    String
  pessoa      Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  tipo        String   // "principal" | "entrega"
  apelido     String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  codigoIbge  String?
  createdAt   DateTime @default(now())
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  password           String
  cargo              String?            @default("")
  active             Boolean            @default(true)
  tokenVersion       Int                @default(0)
  roles              UserRole[]
  companies          UserCompany[]
  permissoesExtras   UserPermission[]
  paginasPermitidas  UserPageAccess[]
  logsDeAuditoria    LogDeAuditoria[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model UserPageAccess {
  userId  String
  pageKey String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, pageKey])
}

model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id               String           @id @default(uuid())
  module           String
  action           String
  key              String           @unique
  roles            RolePermission[]
  usuariosExtras   UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model LogDeAuditoria {
  id            String   @id @default(uuid())
  usuarioId     String
  acao          String
  entidade      String
  entidadeId    String
  valoresAntes  Json?
  valoresDepois Json?
  criadoEm      DateTime @default(now())
  usuario       User     @relation(fields: [usuarioId], references: [id])
}
